{
    "widgettype": "VBox",
    "options": {
        "width": "100%",
        "height": "100%",
        "padding": "0"
    },
    "subwidgets": [
        {
            "widgettype": "HBox",
            "options": {
                "width": "100%",
                "alignItems": "center",
                "marginBottom": "16px"
            },
            "subwidgets": [
                {
                    "widgettype": "Title2",
                    "options": {
                        "text": "应用代码管理"
                    }
                }
            ]
        },
        {
            "widgettype": "VScrollPanel",
            "options": {
                "css": "filler"
            },
            "subwidgets": [
                {
                    "widgettype": "urlwidget",
                    "options": {
                        "url": "{{entire_url('/appbase/appcodes')}}"
                    }
                }
            ]
        }
    ]
}
