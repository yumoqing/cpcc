{
	"widgettype":"HBox",
	"options":{
		"css":"filler"
	},
	"subwidgets":[
		{
			"widgettype":"Text",
			"options":{
				"text":"主菜单",
				"tip":"进入主菜单",
				"css":"clickable"
			},
			"binds":[
				{
					"wid":"self",
					"event":"click",
					"actiontype":"urlwidget",
					"target":"Popup",
					"popup_options":{
						"eventpos":true,
						"dismiss_events":["command"]
					},
					"options":{
						"url":"{{entire_url('menu.ui')}}"
					}
				}
			]
		},
		{
			"widgettype":"Title4",
			"options":{
				"i18n":true,
				"otext":"大模型应用平台",
				"wrap":true,
				"halign":"left"
			}
		}
	]
}
