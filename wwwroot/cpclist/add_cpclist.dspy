
ns = params_kw.copy()
id = params_kw.id
if not id or len(id) > 32:
	id = uuid()
ns['id'] = id

if params_kw.get('api_pwd'):
	ns['api_pwd'] = password_encode(params_kw.get('api_pwd'))



userorgid = await get_userorgid()
if not userorgid:
	return {
		"widgettype":"Error",
		"options":{
			"title":"Authorization Error",
			"timeout":3,
			"cwidth":16,
			"cheight":9,
			"message":"Please login"
		}
	}
ns['orgid'] = userorgid

db = DBPools()
dbname = await rfexe('get_module_dbname', 'cpcc')
async with db.sqlorContext(dbname) as sor:
    r = await sor.C('cpclist', ns.copy())
    return {
        "widgettype":"Message",
        "options":{
			"user_data":ns,
			"cwidth":16,
			"cheight":9,
            "title":"Add Success",
			"timeout":3,
            "message":"ok"
        }
    }

return {
    "widgettype":"Error",
    "options":{
        "title":"Add Error",
		"cwidth":16,
		"cheight":9,
		"timeout":3,
        "message":"failed"
    }
}